pipeline {
    agent any

    environment {
        VIRTUAL_ENV = 'venv'
    }

    stages {
        stage('Setup') {
            steps {
                script {
                    if (!fileExists("${env.WORKSPACE}/${VIRTUAL_ENV}")) {
                        bat 'python -m venv "%VIRTUAL_ENV%"'
                    }

                    bat '"%VIRTUAL_ENV%\\Scripts\\python.exe" -m pip install -r requirements.txt'
                }
            }
        }

        stage('Lint') {
            steps {
                script {
                    bat '"%VIRTUAL_ENV%\\Scripts\\python.exe" -m flake8 app.py'
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    bat '"%VIRTUAL_ENV%\\Scripts\\python.exe" -m pytest -v'
                }
            }
        }

        stage('Coverage') {
            steps {
                script {
                    bat '"%VIRTUAL_ENV%\\Scripts\\python.exe" -m coverage run --source=app -m pytest -v'

                    bat '"%VIRTUAL_ENV%\\Scripts\\python.exe" -m coverage report -m'

                    bat '"%VIRTUAL_ENV%\\Scripts\\python.exe" -m coverage html'

                    bat '"%VIRTUAL_ENV%\\Scripts\\python.exe" -m coverage xml'

                    archiveArtifacts artifacts: 'htmlcov/**,coverage.xml'
                }
            }
        }

        stage('Security Scan') {
            steps {
                script {
                    bat '"%VIRTUAL_ENV%\\Scripts\\python.exe" -m bandit app.py deploy.py'
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    bat '"%VIRTUAL_ENV%\\Scripts\\python.exe" deploy.py'
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}